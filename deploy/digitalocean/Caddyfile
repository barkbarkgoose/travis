# Install as /etc/caddy/Caddyfile; replace the hostname if necessary.
# Caddy runs on the host, not in the Compose network.
travis.allbarker.com {
    request_body {
        # The app permits 25 MiB photos; allow multipart overhead.
        max_size 30MB
    }
    reverse_proxy 127.0.0.1:8000
    # No file_server/media alias: private files stay behind Django authorization.
    # Access logging is intentionally omitted to avoid recording invite tokens.
}
