# Copy OUTSIDE the checkout to /etc/travis-recovery/app.env (chmod 600).
# Run: sudo scripts/deploy-vps.sh /etc/travis-recovery/app.env RELEASE_TAG
# Docker Engine + Compose v2 are required. Configure host Caddy separately.
# Replace placeholders; do not change existing encryption keys during migration.
APP_IMAGE_TAG=initial
ALLOWED_HOSTS=travis.allbarker.com
SECRET_KEY=replace-with-a-strong-stable-secret
SETTINGS_ENCRYPTION_KEY=replace-with-a-stable-fernet-key
# Generate a URL-safe random password (letters/numbers/_/- only).
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
MEDIA_STORAGE_BACKEND=filesystem
SECURE_HSTS_SECONDS=86400
# Optional provider-independent GCS media support: select gcs and set all three.
# GCS_PROJECT_ID=
# GCS_BUCKET_NAME=
# GCS_CREDENTIALS_JSON_B64=
